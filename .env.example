# API same-origin proxy. In development the Vite server forwards this route.
VITE_LALIGA_API_BASE=/api/laliga

# Public OAuth client identifiers observed in the LaLiga Fantasy B2C client.
# They can change without notice; keep overrides here rather than in the UI.
VITE_LALIGA_CLIENT_ID=6457fa17-1224-416a-b21a-ee6ce76e9bc0
VITE_LALIGA_EMAIL_CLIENT_ID=af88bcff-1157-40a0-b579-030728aacf0b
VITE_LALIGA_OAUTH_CLIENT_ID=af88bcff-1157-40a0-b579-030728aacf0b

# Must be an HTTPS URL registered/allowed by LALIGA's B2C application.
# For local experiments, change this only if that redirect has been authorized.
VITE_LALIGA_REDIRECT_URI=http://localhost:5173/auth/callback

# Production server
PORT=4173
